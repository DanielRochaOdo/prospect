# Obrigatória: obter no Neon (Connection Details; preferir pooled para runtime)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/prospect?sslmode=require
# Configurar apenas na Vercel. Usado uma única vez para criar o administrador via /setup.
SETUP_TOKEN=gere-um-segredo-de-pelo-menos-32-caracteres
# Integrações: obter chaves diretamente nos respectivos portais e salvar na Vercel
CNPJ_AI_API_KEY=
LOCALIZACNPJ_API_KEY=
GOOGLE_PLACES_API_KEY=
# Pesquisa de gestores: Exa requer API Key; OpenCNPJ é público e não exige chave
EXA_API_KEY=
# O Next.js configura NODE_ENV automaticamente no build e no runtime.
